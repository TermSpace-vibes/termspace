{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Termspace",
  "version": "0.6.1",
  "identifier": "com.termspace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Termspace v0.6.1",
        "width": 800,
        "height": 600,
        "transparent": true,
        "backgroundColor": "#1a1612ff",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/TermSpace-vibes/termspace/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGNTVCNURFNUM0RjZBMUMKUldRY2FrOWMzclZWdi9QeG9CYndLcmV3Um9FWkUyaFlKSy84MkVQYlhJemx0ZWJYTG5yanZRYTgK"
    }
  }
}
